{
  "name": "iman",
  "version": "0.1.0",
  "description": "Iman (إيمان): a free, open-source, offline-first Muslim prayer app (PWA).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<username>/iman.git"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "vendor": "node scripts/vendor.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cities": "node scripts/build-cities.mjs"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "adhan": "4.4.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
